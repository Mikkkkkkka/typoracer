<main class="page-content">
    <section class="page-section text-section page-section--narrow">
        <h1>Submit your quote</h1>
        <p>
            Add a quote for moderation.
        </p>
    </section>
    <section class="page-section">
        <form class="generic-form" id="quote-form" action="/api/quotes" method="post" enctype="multipart/form-data"
              onsubmit="return false;">
            <div class="generic-form__container">
                <label class="generic-form__label" for="quote-text">Quote text</label>
                <textarea class="generic-form__textarea" id="quote-text" name="text"
                          placeholder="The quick brown fox..." required minlength="3" maxlength="500"></textarea>
                <label class="generic-form__label" for="quote-source">Source (optional)</label>
                <input class="generic-form__text-input" type="text" name="source" id="quote-source"
                       placeholder="Unknown" maxlength="100"/>
                <label class="generic-form__label" for="quote-image">Image (optional)</label>
                <input class="generic-form__text-input" type="file" name="image" id="quote-image"
                       accept="image/png,image/jpeg,image/webp,image/gif"/>
                <p class="generic-form__error" id="quote-form-error" role="alert" aria-live="polite">
                    Submitted quotes appear here after a successful request.
                </p>
                <button type="button" class="generic-form__submit-button" id="clear-form">
                    Submit!
                </button>
            </div>
        </form>
    </section>
    <section class="page-section quote-submissions-section">
        <h2>Your submissions</h2>
        <table class="quote-submissions" id="quote-submissions">
            <thead class="quote-submissions__head">
            <tr>
                <th class="quote-submissions__header">#</th>
                <th class="quote-submissions__header">Submitted at</th>
                <th class="quote-submissions__header quote-submissions__header--wide">Quote</th>
                <th class="quote-submissions__header">Source</th>
                <th class="quote-submissions__header">Edit</th>
                <th class="quote-submissions__header">Delete</th>
            </tr>
            </thead>
            <tbody>
            <tr class="quote-submissions__row">
                <td class="quote-submissions__cell">-</td>
                <td class="quote-submissions__cell">-</td>
                <td class="quote-submissions__cell">No submissions yet.</td>
                <td class="quote-submissions__cell">-</td>
                <td class="quote-submissions__cell">
                    <button type="button" class="quote-submissions__action-button" disabled>Edit</button>
                </td>
                <td class="quote-submissions__cell">
                    <button type="button" class="quote-submissions__action-button" disabled>Delete</button>
                </td>
            </tr>
            </tbody>
        </table>
        <template id="quote-submission-row-template">
            <tr class="quote-submissions__row">
                <td class="quote-submissions__cell" data-field="id"></td>
                <td class="quote-submissions__cell" data-field="date"></td>
                <td class="quote-submissions__cell" data-field="text"></td>
                <td class="quote-submissions__cell" data-field="source"></td>
                <td class="quote-submissions__cell">
                    <button type="button" class="quote-submissions__action-button" data-action="edit">Edit</button>
                </td>
                <td class="quote-submissions__cell">
                    <button type="button" class="quote-submissions__action-button" data-action="delete">Delete</button>
                </td>
            </tr>
        </template>
    </section>
</main>
<script src="/js/quote-submission.js?v=2"></script>
