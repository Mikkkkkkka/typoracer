<header class="main-header margined">
    <% const viewer = typeof currentUser !== 'undefined' ? currentUser : (locals.currentUser ?? null); %>
    <a class="logo" href="/">
        <img class="logo__image" src="/assets/keyboard-icon.svg" alt="Keyboard"/>
        <span class="logo__text">Typoracer</span>
    </a>
    <nav class="nav-bar">
        <a class="nav-bar__link" href="/">home</a>
        <a class="nav-bar__link"  href="/quotes">quotes</a>
        <a class="nav-bar__link" href="/forums">forums</a>
        <a class="nav-bar__link" href="/leaderboard">leaderboard</a>
    </nav>
    <div class="user-info">
        <% if (viewer) { %>
            <a class="user-info__username-link" href="/users/me"><span class="user-info__username"><%= viewer.username %></span></a>
            <form action="/auth/logout" method="post">
                <button class="user-info__button" type="submit">logout</button>
            </form>
        <% } else { %>
            <a class="user-info__button" href="/auth/login">sign in</a>
            <a class="user-info__button" href="/auth/register">register</a>
        <% } %>
        <img class="user-info__image" src="/assets/user-icon.svg" alt="User"/>
    </div>
</header>
