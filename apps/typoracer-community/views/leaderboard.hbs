{{#> main}}
    <section class="competition-section margined" id="competition-section">
        <h1>Leaderboard</h1>
        <table class="leaderboard" id="leaderboard-table">
            <thead class="leaderboard__head">
            <tr>
                <th class="leaderboard__header">#</th>
                <th class="leaderboard__header--wide">Name</th>
                <th class="leaderboard__header">Avg. WPM</th>
                <th class="leaderboard__header">Avg. Acc</th>
            </tr>
            </thead>
            <tbody class="leaderboard__body">
            <tr class="leaderboard__row">
                <td class="leaderboard__cell">1</td>
                <td class="leaderboard__cell">SpeedyFox</td>
                <td class="leaderboard__cell">102</td>
                <td class="leaderboard__cell">99%</td>
            </tr>
            <tr class="leaderboard__row">
                <td class="leaderboard__cell">2</td>
                <td class="leaderboard__cell">KeyMaster</td>
                <td class="leaderboard__cell">97</td>
                <td class="leaderboard__cell">96%</td>
            </tr>
            <tr class="leaderboard__row">
                <td class="leaderboard__cell">3</td>
                <td class="leaderboard__cell">SwiftType</td>
                <td class="leaderboard__cell">93</td>
                <td class="leaderboard__cell">95%</td>
            </tr>
            </tbody>
        </table>
        <blockquote class="competition__quote" cite="https://techhelp.ca/quotes-on-competition/">
            "Competition is always a good thing. It forces us to do our best."
        </blockquote>
    </section>
    <div class="separator"></div>
{{/main}}
