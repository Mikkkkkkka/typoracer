<main class="page-content">
    <section class="text-section">
        <h1>Quote <%= quote.id %></h1>
        <div class="grid__card card">
            <img class="card__image" src="<%= quote.image %>" alt="<%= quote.alt %>" />
            <p class="card__text"><%= quote.text %></p>
        </div>
    </section>
    <div class="separator"></div>
</main>
