<main class="page-content">
    <section class="page-section discussion-section">
        <div class="simple-columns">
            <article class="card discussion-card">
                <p class="discussion-card__meta">Joined <%= user.joinedAt %></p>
                <h1><%= user.username %></h1>
                <p><%= user.bio ?? 'No bio yet.' %></p>
                <% if (isOwnProfile) { %>
                    <p><a href="/users/<%= encodeURIComponent(user.username) %>/edit">Edit profile</a></p>
                    <form action="/users/<%= encodeURIComponent(user.username) %>/delete" method="post">
                        <button class="user-info__button" type="submit">Delete account</button>
                    </form>
                <% } %>
            </article>
            <article class="card discussion-reply">
                <p class="discussion-reply__author">Typing stats</p>
                <p>WPM: <%= user.stats.wpm %></p>
                <p>Accuracy: <%= user.stats.accuracy %>%</p>
                <p>Discussions started: <%= user.stats.discussions %></p>
            </article>
        </div>
        <div class="discussion-replies">
            <article class="card discussion-reply">
                <p class="discussion-reply__author">Recent discussions</p>
                <% if (userDiscussions.length === 0) { %>
                    <p>No discussions started yet.</p>
                <% } %>
                <% userDiscussions.forEach((discussion) => { %>
                    <p><a href="/forums/<%= discussion.id %>"><%= discussion.title %></a></p>
                <% }) %>
            </article>
        </div>
    </section>
</main>
