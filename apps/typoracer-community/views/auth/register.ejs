<main class="page-content">
    <section class="page-section page-section--narrow">
        <div class="section-intro">
            <h1>Create account</h1>
            <p class="text-section__paragraph">Register a local account backed by JWT authentication.</p>
        </div>
        <form class="generic-form__container" action="/auth/register" method="post">
            <label class="generic-form__label" for="username">Username</label>
            <input id="username" class="generic-form__text-input" type="text" name="username" minlength="3" maxlength="32" required />

            <label class="generic-form__label" for="password">Password</label>
            <input id="password" class="generic-form__text-input" type="password" name="password" minlength="8" required />

            <button class="generic-form__submit-button" type="submit">Create account</button>
        </form>
        <p class="text-section__paragraph">Already registered? <a href="/auth/login">Sign in instead</a>.</p>
    </section>
</main>
